# Copy to .env and fill in. Never commit .env.

# --- GitHub -------------------------------------------------------------------------------
# A fine-grained personal access token with READ-ONLY access to the repositories you want
# to inspect. Repository permissions needed: "Actions: Read-only" and "Metadata: Read-only".
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Database / queue ---------------------------------------------------------------------
# Used only when running Python directly on your machine; Docker Compose overrides both.
# Postgres is published on host port 5433 (see compose.yaml).
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5433/devpilot
REDIS_URL=redis://localhost:6379/0

# --- API ----------------------------------------------------------------------------------
# Browser origins allowed to call the API (the React frontend's dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Max characters returned by GET /api/v1/runs/{run_id}/logs (the end of the log is kept).
LOG_MAX_CHARS=200000

# --- AI analysis --------------------------------------------------------------------------
# heuristic  = no AI model, no key: offline pattern matching, clearly labelled, confidence "low".
# anthropic  = Anthropic Messages API (AI_API_KEY + AI_MODEL, e.g. claude-sonnet-5-5).
# openai     = OpenAI, or any OpenAI-compatible server via AI_BASE_URL (e.g. Ollama:
#              AI_BASE_URL=http://host.docker.internal:11434/v1).
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
# Log characters sent to the model (the end of the log is kept). Bigger = more cost.
AI_LOG_MAX_CHARS=60000

# Queued analyses fail after this long without a worker; a job is killed after the second.
ANALYSIS_QUEUE_TIMEOUT_SECONDS=600
ANALYSIS_JOB_TIMEOUT_SECONDS=600
